{
  "name": "Document Auto-Ingestion to RAG",
  "nodes": [
    {
      "parameters": {
        "path": "new-document",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook - New Document",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "new-document-trigger"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/n8n/ingest-webhook",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "file_path",
              "value": "={{$json[\"file_path\"]}}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Secret",
              "value": "change-me"
            }
          ]
        }
      },
      "id": "http-ingest",
      "name": "Call RAG Ingestion API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{$json[\"chunks\"]}}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-success",
      "name": "If Ingestion Succeeded",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [750, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "message",
              "value": "=New document ingested: {{$json[\"filename\"]}} ({{$json[\"chunks\"]}} chunks)"
            }
          ]
        }
      },
      "id": "notify-success",
      "name": "Notify Success",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1000, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "message",
              "value": "Document ingestion failed - check API logs"
            }
          ]
        }
      },
      "id": "notify-failure",
      "name": "Notify Failure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1000, 400]
    }
  ],
  "connections": {
    "Webhook - New Document": {
      "main": [[{ "node": "Call RAG Ingestion API", "type": "main", "index": 0 }]]
    },
    "Call RAG Ingestion API": {
      "main": [[{ "node": "If Ingestion Succeeded", "type": "main", "index": 0 }]]
    },
    "If Ingestion Succeeded": {
      "main": [
        [{ "node": "Notify Success", "type": "main", "index": 0 }],
        [{ "node": "Notify Failure", "type": "main", "index": 0 }]
      ]
    }
  }
}
